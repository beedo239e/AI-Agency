---
import Icon from "./Icon.astro";
import { t, type Lang } from "../i18n";
interface Props { lang: Lang }
const d = t(Astro.props.lang).trust;
---
<section class="strip" aria-label={d.title}>
  <div class="container strip__inner">
    <p class="strip__title">{d.title}</p>
    <ul class="strip__list">
      {d.items.map((it) => <li><Icon name={it.icon} size={20} />{it.label}</li>)}
    </ul>
  </div>
</section>
<style>
  .strip { border-block: 1px solid var(--line); background: var(--surface); }
  .strip__inner { display: flex; align-items: center; justify-content: space-between; gap: 1rem 2rem; flex-wrap: wrap; padding-block: 1.25rem; }
  .strip__title { font-size: var(--fs-sm); font-weight: 600; color: var(--muted); white-space: nowrap; }
  .strip__list { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: .5rem 1.75rem; }
  .strip__list li { display: inline-flex; align-items: center; gap: .5rem; font-weight: 600; color: var(--ink-2); }
  .strip__list :global(svg) { color: var(--brand); }
  @media (max-width: 860px) {
    .strip__inner { justify-content: center; text-align: center; }
    .strip__list { justify-content: center; gap: .6rem 1.25rem; }
  }
</style>
