---
import { t, type Lang } from "../i18n";
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang).calculator;
const fields = [
  { id: "msgs", label: d.messages, min: 10, max: 400, step: 10, value: 80, suffix: "" },
  { id: "mins", label: d.minutes, min: 1, max: 10, step: 1, value: 3, suffix: "" },
  { id: "share", label: d.automated, min: 20, max: 90, step: 5, value: 60, suffix: "%" },
  { id: "salary", label: d.salary, min: 300000, max: 2000000, step: 50000, value: 750000, suffix: "" },
];
---
<section class="section section--surface">
  <div class="container calc" data-calc>
    <div class="reveal">
      <p class="eyebrow">{d.eyebrow}</p>
      <h2 class="h2">{d.title}</h2>
      <p class="lead">{d.lead}</p>
      <div class="calc__inputs">
        {fields.map((f) => (
          <div class="range">
            <div class="range__top">
              <label for={`calc-${f.id}`}>{f.label}</label>
              <output class="num" for={`calc-${f.id}`} data-out={f.id} data-suffix={f.suffix}>{f.value.toLocaleString("en-US")}{f.suffix}</output>
            </div>
            <input type="range" id={`calc-${f.id}`} name={f.id} min={f.min} max={f.max} step={f.step} value={f.value} />
          </div>
        ))}
      </div>
    </div>
    <div class="calc__result reveal" aria-live="polite">
      <div class="calc__big"><span class="num" data-res="hours">0</span><small>{d.resultHours}</small></div>
      <div class="calc__row"><span class="num" data-res="value">0</span><small>{d.resultValue}</small></div>
      <div class="calc__row"><span class="num" data-res="staff">0%</span><small>{d.resultStaff}</small></div>
      <p class="calc__note">{d.disclaimer}</p>
      <a class="btn btn--light btn--block" href="#contact">{d.cta}</a>
    </div>
  </div>
</section>
<style>
  .calc { display: grid; grid-template-columns: 1.2fr 1fr; gap: clamp(2rem, 1rem + 4vw, 5rem); align-items: center; }
  .calc__inputs { display: grid; gap: 1.5rem; margin-block-start: 2rem; }
  .range__top { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; margin-block-end: .5rem; }
  .range label { font-weight: 600; font-size: var(--fs-sm); color: var(--ink-2); }
  .range output { font-weight: 700; color: var(--ink); }
  input[type="range"] { width: 100%; accent-color: var(--brand); height: 28px; cursor: pointer; }
  .calc__result { background: var(--brand-ink); color: #fff; border-radius: var(--radius-lg); padding: clamp(1.75rem, 1.5rem + 1vw, 2.5rem); box-shadow: var(--shadow-lg); }
  .calc__big { display: grid; padding-block-end: 1.25rem; border-block-end: 1px solid rgba(255,255,255,.14); }
  .calc__big span { font-size: clamp(3rem, 2rem + 4vw, 4.5rem); font-weight: 700; line-height: 1.05; letter-spacing: -.02em; }
  .calc__big small, .calc__row small { color: #b6d6d1; font-size: var(--fs-sm); }
  .calc__row { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; padding-block: 1rem; border-block-end: 1px solid rgba(255,255,255,.14); }
  .calc__row span { font-size: var(--fs-xl); font-weight: 700; order: 2; }
  .calc__note { font-size: var(--fs-xs); color: #9cc3bd; margin-block: 1rem 1.25rem; }
  @media (max-width: 860px) { .calc { grid-template-columns: 1fr; } }
</style>
<script>
  for (const root of document.querySelectorAll<HTMLElement>("[data-calc]")) {
    const get = (n: string) => Number(root.querySelector<HTMLInputElement>(`input[name=${n}]`)!.value);
    const set = (k: string, v: string) => { root.querySelector<HTMLElement>(`[data-res=${k}]`)!.textContent = v; };
    const fmt = (n: number) => Math.round(n).toLocaleString("en-US");
    const update = () => {
      const msgs = get("msgs"), mins = get("mins"), share = get("share") / 100, salary = get("salary");
      const hoursPerMonth = (msgs * mins * 26) / 60;          // time spent on messages
      const saved = hoursPerMonth * share;                    // time the assistant can absorb
      const hourly = salary / (26 * 8);
      set("hours", fmt(saved));
      set("value", fmt(saved * hourly));
      set("staff", `${Math.min(100, Math.round((saved / (26 * 8)) * 100))}%`);
      root.querySelectorAll<HTMLOutputElement>("[data-out]").forEach((o) => {
        o.textContent = `${fmt(get(o.dataset.out!))}${o.dataset.suffix ?? ""}`;
      });
    };
    root.querySelectorAll("input").forEach((i) => i.addEventListener("input", update));
    update();
  }
</script>
