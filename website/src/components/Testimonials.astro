---
import Icon from "./Icon.astro";
import { t, type Lang } from "../i18n";
import { testimonials } from "../data/clients";
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang).testimonials;
---
<section class="section section--sunken">
  <div class="container">
    <div class="section-head section-head--center reveal">
      <p class="eyebrow">{d.eyebrow}</p>
      <h2 class="h2">{d.title}</h2>
    </div>
    <div class="quotes">
      {testimonials.map((q) => (
        <figure class:list={["quote reveal", { "is-sample": q.placeholder }]}>
          {q.placeholder && <span class="quote__sample">{d.sampleNote}</span>}
          <div class="quote__stars" aria-label={`${q.rating}/5`}>
            {Array.from({ length: 5 }, (_, i) => <Icon name="star" size={18} class={i < q.rating ? "on" : ""} />)}
          </div>
          <blockquote>{q.quote[lang]}</blockquote>
          <figcaption>
            <span class="quote__avatar" aria-hidden="true">{q.name.replace(/[\[\]]/g, "").charAt(0)}</span>
            <span><strong>{q.name}</strong><small>{q.role[lang]} · {q.business[lang]}</small></span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
<style>
  .quotes { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
  .quote { position: relative; display: flex; flex-direction: column; gap: 1.25rem; padding: 1.75rem; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-lg); }
  .quote.is-sample { border-style: dashed; border-color: var(--line-strong); }
  .quote__sample { position: absolute; top: -11px; inset-inline-start: 1.25rem; font-size: .7rem; font-weight: 600; color: #7a5512; background: var(--gold-soft); padding: .1rem .55rem; border-radius: 999px; }
  .quote__stars { display: flex; gap: 2px; color: var(--line-strong); }
  .quote__stars :global(.on) { color: var(--gold); fill: var(--gold); }
  .quote blockquote { font-size: var(--fs-md); line-height: 1.75; flex: 1; }
  .quote figcaption { display: flex; align-items: center; gap: .75rem; }
  .quote figcaption > span:last-child { display: grid; line-height: 1.4; }
  .quote small { color: var(--muted); font-size: var(--fs-xs); }
  .quote__avatar { width: 42px; height: 42px; border-radius: 50%; display: grid; place-items: center; background: var(--brand-soft); color: var(--brand); font-weight: 700; }
  @media (max-width: 960px) { .quotes { grid-template-columns: 1fr; max-width: 560px; margin-inline: auto; } }
</style>
