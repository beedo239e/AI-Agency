---
import Icon from "./Icon.astro";
import { t, type Lang } from "../i18n";
import { testimonials, sectorIcon } from "../data/clients";
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang).testimonials;
const hasExamples = testimonials.some((q) => q.example);
---
<section class="section" id="stories">
  <div class="container">
    <div class="section-head section-head--center">
      <p class="eyebrow">{d.eyebrow}</p>
      <h2 class="h2">{d.title}</h2>
      <p class="lead">{d.lead}</p>
      {hasExamples && <p class="stories__note"><span aria-hidden="true">*</span> {d.exampleNote}</p>}
    </div>
    <div class="stories">
      {testimonials.map((q) => (
        <figure class="story">
          <Icon name="quote" size={22} class="story__mark" />
          <blockquote>{q.quote[lang]}</blockquote>
          <span class="chip story__hl"><Icon name="check" size={14} />{q.highlight[lang]}</span>
          <figcaption>
            <span class="story__avatar" aria-hidden="true"><Icon name={sectorIcon[q.sector]} size={20} /></span>
            <span class="story__who">
              <strong>{q.name ?? q.role[lang]}</strong>
              <small>{q.name ? `${q.role[lang]} · ` : ""}{q.city[lang]}{q.example ? " *" : ""}</small>
            </span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
<style>
  .stories__note { margin-block-start: .75rem; font-size: var(--fs-xs); color: var(--muted); }
  .stories { columns: 3 300px; column-gap: 1.25rem; }
  .story {
    break-inside: avoid; margin-block-end: 1.25rem;
    display: grid; gap: 1rem; padding: 1.5rem;
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-lg);
  }
  .story :global(.story__mark) { color: var(--gold); }
  [dir="rtl"] .story :global(.story__mark) { transform: scaleX(-1); }
  .story blockquote { font-size: var(--fs-md); line-height: 1.8; color: var(--ink); }
  .story__hl { justify-self: start; }
  .story figcaption { display: flex; align-items: center; gap: .75rem; padding-block-start: 1rem; border-block-start: 1px solid var(--line); }
  .story__avatar { flex: none; width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; background: var(--brand-soft); color: var(--brand); }
  .story__who { display: grid; line-height: 1.4; }
  .story__who strong { font-size: var(--fs-sm); }
  .story__who small { color: var(--muted); font-size: var(--fs-xs); }
</style>
