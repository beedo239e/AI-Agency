---
import ChatDemo from "./ChatDemo.astro";
import Icon from "./Icon.astro";
import { t, href, type Lang } from "../i18n";
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang).hero;
---
<section class="hero">
  <div class="container hero__grid">
    <div class="hero__copy">
      <span class="chip"><Icon name="sparkles" size={14} />{d.eyebrow}</span>
      <h1 class="hero__title">{d.titleA} <span>{d.titleB}</span></h1>
      <p class="hero__sub">{d.sub}</p>
      <div class="hero__ctas">
        <a class="btn btn--primary" href="#contact">{d.primary}<Icon name="arrow" class="flip" /></a>
        <a class="btn btn--secondary" href={href(lang, "/pricing")}>{d.secondary}</a>
      </div>
      <ul class="hero__assure">
        {d.assurances.map((a) => <li><Icon name="checkCircle" size={18} />{a}</li>)}
      </ul>
    </div>
    <div class="hero__demo">
      <ChatDemo lang={lang} />
    </div>
  </div>
</section>
<style>
  .hero { padding-block: clamp(2.5rem, 2rem + 4vw, 5.5rem) clamp(3.5rem, 3rem + 4vw, 6rem); position: relative; overflow: hidden; }
  .hero::before {
    content: ""; position: absolute; inset: -20% -10% auto auto; width: 60vw; height: 60vw; max-width: 760px; max-height: 760px;
    background: radial-gradient(closest-side, rgba(13,110,102,.10), transparent 70%); pointer-events: none;
  }
  [dir="rtl"] .hero::before { inset: -20% auto auto -10%; }
  .hero__grid { position: relative; display: grid; grid-template-columns: 1.15fr 1fr; gap: clamp(2rem, 1rem + 4vw, 5rem); align-items: center; }
  .hero__title { font-size: var(--fs-3xl); margin-block: 1.1rem 1.25rem; letter-spacing: -.02em; line-height: 1.15; }
  .hero__title span { color: var(--brand); display: block; }
  .hero__sub { font-size: var(--fs-lg); color: var(--ink-2); max-width: 56ch; line-height: 1.75; }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: .75rem; margin-block: 2rem 1.75rem; }
  .hero__assure { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: .5rem 1.5rem; color: var(--ink-2); font-size: var(--fs-sm); }
  .hero__assure li { display: inline-flex; align-items: center; gap: .4rem; }
  .hero__assure :global(svg) { color: var(--brand); }
  @media (max-width: 960px) {
    .hero__grid { grid-template-columns: 1fr; }
    .hero__ctas .btn { flex: 1 1 200px; }
  }
</style>
