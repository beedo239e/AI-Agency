---
import "@fontsource/ibm-plex-sans-arabic/400.css";
import "@fontsource/ibm-plex-sans-arabic/500.css";
import "@fontsource/ibm-plex-sans-arabic/600.css";
import "@fontsource/ibm-plex-sans-arabic/700.css";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import WhatsAppFab from "../components/WhatsAppFab.astro";
import { t, altPath, type Lang } from "../i18n";
import { site } from "../data/site";

interface Props { lang: Lang; title?: string; description?: string }
const { lang, title, description } = Astro.props;
const d = t(lang);
const pageTitle = title ?? d.meta.title;
const pageDesc = description ?? d.meta.description;
const canonical = new URL(Astro.url.pathname, site.url).href;
const alternate = new URL(altPath(lang, Astro.url.pathname), site.url).href;
---
<!doctype html>
<html lang={d.meta.lang} dir={d.meta.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang} href={canonical} />
    <link rel="alternate" hreflang={lang === "ar" ? "en" : "ar"} href={alternate} />
    <link rel="icon" type="image/png" href="/favicon-64.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#faf8f4" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === "ar" ? "ar_IQ" : "en_US"} />
    <meta name="twitter:card" content="summary" />
    <script is:inline>document.documentElement.classList.add("js")</script>
  </head>
  <body>
    <a class="skip-link" href="#main">{d.nav.skip}</a>
    <Header lang={lang} />
    <main id="main"><slot /></main>
    <Footer lang={lang} />
    <WhatsAppFab lang={lang} />
    <script>
      // Reveal-on-scroll, progressive enhancement only.
      const els = document.querySelectorAll<HTMLElement>(".reveal");
      if ("IntersectionObserver" in window && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
        const io = new IntersectionObserver(
          (entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add("is-in"); io.unobserve(e.target); } }),
          { rootMargin: "0px 0px -8% 0px", threshold: 0.08 },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add("is-in"));
      }
    </script>
  </body>
</html>
